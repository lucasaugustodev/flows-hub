PORT=4100
PUBLIC_BASE_URL=http://localhost:4100
API_KEYS=replace-me-comma-separated
BROWSERLESS_TOKEN=pageflows-dev
BROWSERLESS_WS=ws://browserless:3000/chromium/playwright?token=pageflows-dev
DB_FILE=/data/pageflows.db
DATA_DIR=/data

# Optional — only needed if using `pageflows agent run` or LLM auto-heal in replay
OPENROUTER_API_KEY=

# Internal-mode signup (Resend OTP)
RESEND_API_KEY=
EMAIL_FROM=pageflows <noreply@somosahub.com.br>
SIGNUP_ALLOWED_DOMAIN=somosahub.com.br
# Set to 'false' to disable auto-sharing all projects with new users
AUTO_SHARE_PROJECTS=true
